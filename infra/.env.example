# Server only: copy to /opt/svanda-web/infra/.env on the box (mode 600, owner deploy) and fill
# in. Never commit the real file. Generate secrets with `openssl rand -hex 32`.

# Contact API (apps/contact-api): Google Workspace SMTP for the sender mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=business@svanda.fun
ALTCHA_HMAC_KEY=
ALLOWED_ORIGINS=https://svanda.fun

# Umami (stats.svanda.fun) and its Postgres.
UMAMI_DB_PASSWORD=
APP_SECRET=
