    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@svanda/shared": "workspace:*",
    "altcha-lib": "2.6.0",
    "hono": "4.13.13",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
