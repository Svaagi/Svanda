{
  "name": "@svanda/contact-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.spec.json --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
